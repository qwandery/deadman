{
  "name": "deadman",
  "version": "1.0.0",
  "description": "Dead-ass simple tool management — fetch and manage binary assets that don't fit into traditional package managers",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "deadman": "dist/bin/deadman.js"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts'",
    "lint:fix": "eslint --fix 'src/**/*.ts' 'tests/**/*.ts'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "start": "node dist/bin/deadman.js"
  },
  "keywords": [
    "binary",
    "asset",
    "fetch",
    "tool",
    "management",
    "cli",
    "cross-platform"
  ],
  "author": "Brian Lacy",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/"
  ],
  "dependencies": {
    "commander": "^13.1.0",
    "yaml": "^2.7.0",
    "tar": "^7.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "eslint": "^9.21.0",
    "@eslint/js": "^9.21.0",
    "typescript-eslint": "^8.25.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
